# NexusAI environment variables
# The pattern is "secrets live in .env, never in code" — established in
# Phase 1, first used in Phase 2.

# Phase 2 — which LLM provider backs the agent: "groq" (free, default) or
# "anthropic" (paid). Not required for tests, which use a mocked provider.
# LLM_PROVIDER=groq

# --- Groq (default, free tier, no credit card required) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional, defaults to llama-3.3-70b-versatile if unset.
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Anthropic (optional, paid, only used if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=

# Optional, defaults to claude-sonnet-5 if unset.
# ANTHROPIC_MODEL=claude-sonnet-5

# Added in a later phase once PostgreSQL is introduced.
# DATABASE_URL=
